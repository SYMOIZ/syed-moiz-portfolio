---
// "How I work": an illustrative delivery-and-operations loop, edited in /lock (workflow.json). Each stage links to where the
// practice actually appears in a project. It is not a live pipeline and shows no live data.
import { workflow as stages } from '../data/profile';
---

<div class="operate" data-operate>
  <div class="operate-track" role="tablist" aria-label="Delivery and operations stages">
    <span class="operate-pulse" aria-hidden="true"></span>
    {stages.map((s, i) => (
      <button
        type="button"
        role="tab"
        class="operate-stage"
        id={`op-tab-${s.id}`}
        aria-controls={`op-panel-${s.id}`}
        aria-selected={i === 0 ? 'true' : 'false'}
        tabindex={i === 0 ? 0 : -1}
        data-stage-index={i}
      >
        <span class="operate-dot" aria-hidden="true"></span>
        <span class="operate-num mono">{String(i + 1).padStart(2, '0')}</span>
        <span class="operate-label">{s.label}</span>
      </button>
    ))}
  </div>

  {stages.map((s, i) => (
    <div
      class="operate-panel card"
      role="tabpanel"
      id={`op-panel-${s.id}`}
      aria-labelledby={`op-tab-${s.id}`}
      hidden={i !== 0}
    >
      <p class="operate-text">{s.text}</p>
      <p class="operate-ev-title mono">Where this shows up</p>
      <ul class="operate-evidence">
        {s.evidence.map((e) => <li>{e.href ? <a href={e.href} class="link-arrow">{e.label}</a> : <span class="link-plain">{e.label}</span>}</li>)}
      </ul>
    </div>
  ))}
</div>
